# Copy to .env and fill in real values. Never commit .env — backend/.gitignore
# excludes it, and the repo is public (spec §16.2).

SARVAM_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
HF_TOKEN=

# Optional overrides — sensible defaults exist in code (see app/artifacts.py,
# app/env_bootstrap.py) if you don't set these.
# RAINGOA_ARTIFACTS_REPO=RaviR2005/raingoa-artifacts
# RAINGOA_HF_CACHE=D:\dev-cache\raingoa\hf
# RAINGOA_MODEL_CACHE=D:\dev-cache\raingoa\models
